<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

   <modelVersion>4.0.0</modelVersion>

	<!-- ********************************************** -->
	<!-- ****************** BASE POM ****************** -->
	<!-- ********************************************** -->

   <parent>
      <groupId>com.bernardomg.association.calendar</groupId>
      <artifactId>association-calendar</artifactId>
      <version>0.7.9</version>
   </parent>

	<!-- ********************************************** -->
	<!-- **************** PROJECT INFO **************** -->
	<!-- ********************************************** -->

   <groupId>com.bernardomg.association.calendar</groupId>
   <artifactId>association-calendar-rest-adapter</artifactId>
   <packaging>jar</packaging>

   <name>Calendar REST Adapter</name>

	<!-- ********************************************** -->
	<!-- *************** DEPENDENCIES ***************** -->
	<!-- ********************************************** -->

   <dependencies>
	  <!-- ============================================== -->
	  <!-- ================ FRAMEWORK =================== -->
	  <!-- ============================================== -->
      <dependency>
         <groupId>com.bernardomg.association.calendar</groupId>
         <artifactId>association-calendar-domain</artifactId>
      </dependency>
      <dependency>
         <groupId>com.bernardomg.association.calendar</groupId>
         <artifactId>association-calendar-usecase</artifactId>
      </dependency>
      <dependency>
         <groupId>com.bernardomg.framework.security</groupId>
         <artifactId>access-decorator</artifactId>
      </dependency>
      <dependency>
         <groupId>com.bernardomg.framework.security</groupId>
         <artifactId>security-model</artifactId>
      </dependency>
      <!-- ============================================== -->
      <!-- ================== OPENAPI =================== -->
      <!-- ============================================== -->
      <dependency>
        <groupId>org.openapitools</groupId>
        <artifactId>jackson-databind-nullable</artifactId>
      </dependency>
      <dependency>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-annotations</artifactId>
      </dependency>
      <!-- ============================================== -->
      <!-- ================= JAKARTA ==================== -->
      <!-- ============================================== -->
      <dependency>
          <!-- Jakarta Servlet API -->
         <groupId>jakarta.servlet</groupId>
         <artifactId>jakarta.servlet-api</artifactId>
         <scope>provided</scope>
      </dependency>
      <dependency>
         <!-- Jakarta validation -->
         <groupId>jakarta.validation</groupId>
         <artifactId>jakarta.validation-api</artifactId>
         <scope>provided</scope>
      </dependency>
      <dependency>
         <!-- Jakarta annotation API -->
         <groupId>jakarta.annotation</groupId>
         <artifactId>jakarta.annotation-api</artifactId>
         <scope>provided</scope>
      </dependency>
      <!-- ============================================== -->
      <!-- ================== SPRING ==================== -->
      <!-- ============================================== -->
      <dependency>
         <!-- Spring Web MVC -->
         <groupId>org.springframework</groupId>
         <artifactId>spring-web</artifactId>
      </dependency>
      <dependency>
         <!-- Spring Context -->
         <groupId>org.springframework</groupId>
         <artifactId>spring-context</artifactId>
      </dependency>
      <!-- ============================================== -->
      <!-- ================= JACKSON ==================== -->
      <!-- ============================================== -->
      <dependency>
         <!-- Jackson annotations -->
         <groupId>com.fasterxml.jackson.core</groupId>
         <artifactId>jackson-annotations</artifactId>
      </dependency>
      <!-- ============================================== -->
      <!-- ======= TEST ENVIRONMENT DEPENDENCIES ======== -->
      <!-- ============================================== -->
      <dependency>
         <groupId>com.bernardomg.association.calendar</groupId>
         <artifactId>association-calendar-testing</artifactId>
         <scope>test</scope>
      </dependency>
      <dependency>
         <groupId>com.fasterxml.jackson.datatype</groupId>
         <artifactId>jackson-datatype-jsr310</artifactId>
         <scope>test</scope>
      </dependency>
      <dependency>
         <groupId>org.hibernate.validator</groupId>
         <artifactId>hibernate-validator</artifactId>
         <scope>test</scope>
      </dependency>
      <dependency>
         <!-- Spring Web MVC -->
         <groupId>org.springframework</groupId>
         <artifactId>spring-webmvc</artifactId>
         <scope>test</scope>
      </dependency>
   </dependencies>

	<!-- ********************************************** -->
	<!-- ******************* BUILD ******************** -->
	<!-- ********************************************** -->

   <build>
      <plugins>
          <plugin>
             <groupId>org.openapitools</groupId>
             <artifactId>openapi-generator-maven-plugin</artifactId>
             <executions>
                <execution>
                   <id>activity</id>
                   <goals>
                      <goal>generate</goal>
                   </goals>
                   <configuration>
                      <inputSpec>${project.basedir}/src/main/resources/openapi/activity/activity.yml</inputSpec>
                      <apiPackage>com.bernardomg.association.calendar.activity.adapter.outbound.rest.controller</apiPackage>
                      <modelPackage>com.bernardomg.association.calendar.activity.adapter.outbound.rest.dto</modelPackage>
                   </configuration>
                </execution>
                <execution>
                   <id>calendar_type</id>
                   <goals>
                      <goal>generate</goal>
                   </goals>
                   <configuration>
                      <inputSpec>${project.basedir}/src/main/resources/openapi/calendarType/calendar_type.yml</inputSpec>
                      <apiPackage>com.bernardomg.association.calendar.adapter.outbound.rest.controller</apiPackage>
                      <modelPackage>com.bernardomg.association.calendar.adapter.outbound.rest.dto</modelPackage>
                   </configuration>
                </execution>
                <execution>
                   <id>scheduled_game</id>
                   <goals>
                      <goal>generate</goal>
                   </goals>
                   <configuration>
                      <inputSpec>${project.basedir}/src/main/resources/openapi/scheduledGame/scheduled_game.yml</inputSpec>
                      <apiPackage>com.bernardomg.association.calendar.game.adapter.outbound.rest.controller</apiPackage>
                      <modelPackage>com.bernardomg.association.calendar.game.adapter.outbound.rest.dto</modelPackage>
                   </configuration>
                </execution>
             </executions>
          </plugin>
      </plugins>
   </build>

</project>
