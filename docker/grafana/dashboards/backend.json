{
  "uid": "association-backend",
  "title": "Association Backend \u2014 Local Development",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "development"
  ],
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Backend scrape health (1 = reachable)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "association-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"association-backend\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "association-prometheus"
          },
          "legendFormat": "{{instance}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 2,
      "title": "Request rate by route (excluding Actuator)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "association-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (uri, status) (rate(http_server_requests_seconds_count{job=\"association-backend\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "association-prometheus"
          },
          "legendFormat": "{{uri}} {{status}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 3,
      "title": "5xx error percentage",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "association-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum(rate(http_server_requests_seconds_count{job=\"association-backend\",status=~\"5..\",uri!~\"/actuator.*\"}[$__rate_interval])) / sum(rate(http_server_requests_seconds_count{job=\"association-backend\",uri!~\"/actuator.*\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "association-prometheus"
          },
          "legendFormat": "{{uri}} {{status}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 4,
      "title": "p95 latency by route",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "association-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"association-backend\",uri!~\"/actuator.*\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "association-prometheus"
          },
          "legendFormat": "{{uri}} {{status}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 5,
      "title": "JVM heap used",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "association-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (jvm_memory_used_bytes{job=\"association-backend\",area=\"heap\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "association-prometheus"
          },
          "legendFormat": "{{instance}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "title": "Process CPU",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "association-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * process_cpu_usage{job=\"association-backend\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "association-prometheus"
          },
          "legendFormat": "{{instance}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 7,
      "title": "Database connections: active",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "association-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{job=\"association-backend\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "association-prometheus"
          },
          "legendFormat": "{{instance}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Database connections: pending",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "association-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_pending{job=\"association-backend\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "association-prometheus"
          },
          "legendFormat": "{{instance}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 9,
      "title": "GC pause time per second",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "association-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(jvm_gc_pause_seconds_sum{job=\"association-backend\"}[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "association-prometheus"
          },
          "legendFormat": "{{instance}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 10,
      "title": "Warnings and errors",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "association-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"association-backend\",level=~\"WARN|ERROR|FATAL\"}",
          "datasource": {
            "type": "loki",
            "uid": "association-loki"
          },
          "legendFormat": "{{instance}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "showLabels": true
      }
    }
  ],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  }
}
