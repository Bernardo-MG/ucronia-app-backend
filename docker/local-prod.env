# Local-only values for docker/docker-compose.prod.yml.
# Save as docker/.env; never use these credentials in a public deployment.
BACKEND_IMAGE=ucronia-app-backend:prod-local
POSTGRES_PASSWORD=local-prod-db-password-only
JWT_SECRET=local-prod-test-signing-key-0123456789abcdef0123456789abcdef
CORS_ALLOWED_ORIGINS=http://localhost:4200
ACTIVATE_USER_URL=http://localhost:4200/users/activate
PASSWORD_RECOVERY_URL=http://localhost:4200/password/reset/

# Placeholders: email features require a reachable SMTP server.
SMTP_HOST=host.docker.internal
SMTP_PORT=1025
SMTP_USERNAME=local
SMTP_PASSWORD=local
MAIL_FROM=security@localhost.test

# Placeholders: S3 features require a real or locally reachable S3-compatible service.
AWS_REGION=eu-west-1
S3_BUCKET=ucronia-content
AWS_ACCESS_KEY_ID=local-test
AWS_SECRET_ACCESS_KEY=local-test-secret
