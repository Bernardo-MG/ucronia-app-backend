<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
   xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">

   <modelVersion>4.0.0</modelVersion>

	<!-- ********************************************** -->
	<!-- ****************** BASE POM ****************** -->
	<!-- ********************************************** -->

   <parent>
      <groupId>com.bernardomg.asset</groupId>
      <artifactId>asset</artifactId>
      <version>1.0.0-SNAPSHOT</version>
   </parent>

	<!-- ********************************************** -->
	<!-- **************** PROJECT INFO **************** -->
	<!-- ********************************************** -->

   <groupId>com.bernardomg.asset</groupId>
   <artifactId>asset-rest-adapter</artifactId>
   <packaging>jar</packaging>

   <name>Assets REST Adapter</name>

	<!-- ********************************************** -->
	<!-- **************** PROPERTIES ****************** -->
	<!-- ********************************************** -->

   <properties>
   </properties>

	<!-- ********************************************** -->
	<!-- *************** DEPENDENCIES ***************** -->
	<!-- ********************************************** -->

   <dependencies>
      <dependency>
         <groupId>com.bernardomg.asset</groupId>
         <artifactId>asset-domain</artifactId>
      </dependency>
      <dependency>
         <groupId>com.bernardomg.asset</groupId>
         <artifactId>asset-usecase</artifactId>
      </dependency>
      <dependency>
			<!-- Spring WS Security Starter -->
         <groupId>com.bernardomg.framework.spring</groupId>
         <artifactId>spring-ws-security-starter</artifactId>
      </dependency>
      <!-- ============================================== -->
      <!-- ================== OPENAPI =================== -->
      <!-- ============================================== -->
      <dependency>
        <groupId>org.openapitools</groupId>
        <artifactId>jackson-databind-nullable</artifactId>
      </dependency>
      <dependency>
        <groupId>io.swagger.core.v3</groupId>
        <artifactId>swagger-annotations</artifactId>
      </dependency>
      <!-- ============================================== -->
      <!-- ================= JAKARTA ==================== -->
      <!-- ============================================== -->
      <dependency>
          <!-- Jakarta Servlet API -->
         <groupId>jakarta.servlet</groupId>
         <artifactId>jakarta.servlet-api</artifactId>
         <scope>provided</scope>
      </dependency>
      <dependency>
         <!-- Jakarta validation -->
         <groupId>jakarta.validation</groupId>
         <artifactId>jakarta.validation-api</artifactId>
         <scope>provided</scope>
      </dependency>
      <dependency>
         <!-- Jakarta annotation API -->
         <groupId>jakarta.annotation</groupId>
         <artifactId>jakarta.annotation-api</artifactId>
         <scope>provided</scope>
      </dependency>
      <!-- ============================================== -->
      <!-- ================== SPRING ==================== -->
      <!-- ============================================== -->
      <dependency>
         <!-- Spring Web MVC -->
         <groupId>org.springframework</groupId>
         <artifactId>spring-web</artifactId>
      </dependency>
      <dependency>
         <!-- Spring Context -->
         <groupId>org.springframework</groupId>
         <artifactId>spring-context</artifactId>
      </dependency>
      <!-- ============================================== -->
      <!-- ======= TEST ENVIRONMENT DEPENDENCIES ======== -->
      <!-- ============================================== -->
      <dependency>
         <groupId>com.bernardomg.asset</groupId>
         <artifactId>asset-testing</artifactId>
         <scope>test</scope>
      </dependency>
      <dependency>
         <groupId>com.fasterxml.jackson.datatype</groupId>
         <artifactId>jackson-datatype-jsr310</artifactId>
         <scope>test</scope>
      </dependency>
      <dependency>
         <groupId>org.hibernate.validator</groupId>
         <artifactId>hibernate-validator</artifactId>
         <scope>test</scope>
      </dependency>
      <dependency>
         <!-- Spring Web MVC -->
         <groupId>org.springframework</groupId>
         <artifactId>spring-webmvc</artifactId>
         <scope>test</scope>
      </dependency>
   </dependencies>

	<!-- ********************************************** -->
	<!-- ******************* BUILD ******************** -->
	<!-- ********************************************** -->

   <build>
      <plugins>
          <plugin>
             <groupId>org.openapitools</groupId>
             <artifactId>openapi-generator-maven-plugin</artifactId>
               <executions>
                  <execution>
                     <id>generate-asset-api</id>
                     <goals>
                        <goal>generate</goal>
                     </goals>
                     <configuration>
                        <inputSpec>${project.basedir}/src/main/resources/openapi/asset.yml</inputSpec>
                        <apiPackage>com.bernardomg.asset.adapter.outbound.rest.controller</apiPackage>
                        <modelPackage>com.bernardomg.asset.adapter.outbound.rest.dto</modelPackage>
                        <configOptions>
                           <useResponseEntity>true</useResponseEntity>
                        </configOptions>
                     </configuration>
                  </execution>
                  <execution>
                     <id>generate-file-api</id>
                     <goals>
                        <goal>generate</goal>
                     </goals>
                     <configuration>
                        <inputSpec>${project.basedir}/src/main/resources/openapi/file.yml</inputSpec>
                        <apiPackage>com.bernardomg.file.adapter.outbound.rest.controller</apiPackage>
                        <modelPackage>com.bernardomg.file.adapter.outbound.rest.dto</modelPackage>
                        <configOptions>
                           <useResponseEntity>true</useResponseEntity>
                        </configOptions>
                     </configuration>
                  </execution>
                  <execution>
                     <id>generate-image-api</id>
                     <goals>
                        <goal>generate</goal>
                     </goals>
                     <configuration>
                        <inputSpec>${project.basedir}/src/main/resources/openapi/image.yml</inputSpec>
                        <apiPackage>com.bernardomg.image.adapter.outbound.rest.controller</apiPackage>
                        <modelPackage>com.bernardomg.image.adapter.outbound.rest.dto</modelPackage>
                        <configOptions>
                           <useResponseEntity>true</useResponseEntity>
                        </configOptions>
                     </configuration>
                  </execution>
               </executions>
          </plugin>
      </plugins>
   </build>

</project>
